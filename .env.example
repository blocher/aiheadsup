# Do not put a Gemini key here for the iOS app. Enter it in the app's Settings
# screen instead; it is saved in iOS Keychain by the native bridge.

# ChatGPT sign-in (ChatGPT plan usage) is on in iOS builds. OpenAI offers it to
# personal/local and open-source apps; a paid or App Store release needs OpenAI's
# approval first (https://openai.com/form/sign-in-with-chatgpt-interest/).
# Until then, build App Store releases with it off:
# VITE_CHATGPT_SIGN_IN=off
