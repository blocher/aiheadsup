-- Vue 3 + Vite party game (Capacitor iOS/Android shell). Local dev is a single Vite dev server; decks are committed TOML under src/decks/.: one iTerm window, one stacked pane per service.
property projectID : "forehead-frenzy"

on run
	-- The repo is the folder holding this launcher, so it works in any clone or fork.
	set projectRoot to do shell script "dirname " & quoted form of (POSIX path of (path to me))

	if not iTermInstalled() then
		display alert "iTerm2 is required" message "Install it from https://iterm2.com, then run this launcher again."
		return
	end if
	set missingTools to loginShell(projectRoot, "for t in 'yarn' 'node'; do command -v \"$t\" >/dev/null || printf \"%s \" \"$t\"; done")
	if missingTools is not "" then
		display alert ("Forehead Frenzy needs " & missingTools) message "Install the missing tools (they must be on your login shell's PATH), then run this launcher again."
		return
	end if

	-- Pre-launch step 1: Install JS dependencies
	try
		loginShell(projectRoot, "yarn install")
	on error errorText
		display alert "Install JS dependencies failed" message errorText buttons {"Cancel", "Continue Anyway"} cancel button "Cancel"
	end try

	tell application "Finder" to set screenBounds to bounds of window of desktop

	tell application "iTerm"
		activate
		-- Rerunning replaces this project's window; other iTerm windows are untouched. Each pane gets Ctrl-C
		-- first: closing alone leaves servers that ignore hang-ups (redis-server) running.
		repeat with existingWindow in windows
			try
				tell current session of current tab of existingWindow to set existingTag to variable named "user.launcherProject"
				if existingTag is my projectID then
					repeat with existingSession in sessions of current tab of existingWindow
						tell existingSession to write text (character id 3) newline no
					end repeat
					delay 1.5
					close existingWindow
				end if
			end try
		end repeat

		set devWindow to (create window with default profile)
		set bounds of devWindow to {0, 0, (item 3 of screenBounds) * 0.75, item 4 of screenBounds}

		-- Frontend: Vite dev server (vue plugin); the whole app runs client-side, there is no API server
		set paneFrontend to current session of devWindow
		tell paneFrontend
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Frontend"
			set name to "Forehead Frenzy · Frontend"
			write text "cd " & quoted form of projectRoot
			write text "export FOREHEAD_FRENZY_FRONTEND_PORT=${FOREHEAD_FRENZY_FRONTEND_PORT:-5180}"
			write text "printf '\\033]6;1;bg;red;brightness;16\\a\\033]6;1;bg;green;brightness;21\\a\\033]6;1;bg;blue;brightness;45\\a'"
			write text "pids=$(lsof -t -iTCP:$FOREHEAD_FRENZY_FRONTEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || { kill $pids 2>/dev/null; sleep 0.5; pids=$(lsof -t -iTCP:$FOREHEAD_FRENZY_FRONTEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || kill -9 $pids 2>/dev/null; }; true"
			write text "yarn dev --port $FOREHEAD_FRENZY_FRONTEND_PORT" & " --strictPort"
		end tell
		set lastPane to paneFrontend

		-- Working
		tell lastPane to set paneWorking to (split horizontally with default profile)
		tell paneWorking
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Working"
			set name to "Forehead Frenzy · Working"
			write text "cd " & quoted form of projectRoot
			write text "export FOREHEAD_FRENZY_FRONTEND_PORT=${FOREHEAD_FRENZY_FRONTEND_PORT:-5180}"
			write text "git status --short --branch"
			write text "printf '%s\\n' " & quoted form of ("Forehead Frenzy — web app at http://localhost:5180" & "/") & " " & quoted form of ("Tests:            yarn test          (one-shot)   /  yarn test:watch") & " " & quoted form of ("Build:            yarn build         -> dist/ (Capacitor webDir)") & " " & quoted form of ("Preview a build:  yarn preview --port 5180" & " --strictPort") & " " & quoted form of ("Deck generation:  GEMINI_API_KEY=... yarn generate:decks   (writes src/decks/*.toml; needs an interactive TTY if the key is unset)") & " " & quoted form of ("Native shells:    yarn build && npx cap sync ios   (then open ios/App in Xcode; same for android)") & " " & quoted form of ("Phone on LAN:     yarn dev --host --port 5180" & " --strictPort") & " " & quoted form of ("Store screenshots: yarn preview --port 5180" & " --strictPort, then yarn store:screenshots http://127.0.0.1:5180" & "/")
			write text "exec $SHELL -l"
		end tell
		set lastPane to paneWorking

		-- Leave Frontend selected.
		select paneFrontend
	end tell

	-- Open the app in the default browser once its server answers.
	do shell script "(" & "for i in $(seq 1 240); do nc -z 127.0.0.1 5180 2>/dev/null && break; sleep 0.5; done; " & "open " & quoted form of ("http://localhost:5180" & "/") & ") >/dev/null 2>&1 &"
end run

on iTermInstalled()
	try
		do shell script "open -Ra iTerm"
		return true
	on error
		return false
	end try
end iTermInstalled

-- Runs a command in a login shell at the repo root, so tools on the user's PATH (Homebrew, nvm, uv) are found.
on loginShell(projectRoot, command)
	return do shell script "/bin/zsh -lc " & quoted form of ("cd " & quoted form of projectRoot & " && " & command)
end loginShell
