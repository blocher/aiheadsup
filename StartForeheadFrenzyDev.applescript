hand edits to the script below are overwritten when it's regenerated.
{
  "spec": 1,
  "id": "forehead-frenzy",
  "name": "Forehead Frenzy",
  "description": "Vue 3 + Vite party game (Capacitor iOS/Android shell). Local dev is a single Vite dev server; decks are committed TOML under src/decks/.",
  "url": "http://localhost:{port:Frontend}/",
  "focus": "Frontend",
  "requires": [
    "yarn",
    "node"
  ],
  "preLaunch": [
    {
      "run": "yarn install",
      "label": "Install JS dependencies"
    }
  ],
  "panes": [
    {
      "role": "Frontend",
      "note": "Vite dev server (vue plugin); the whole app runs client-side, there is no API server",
      "port": 5180,
      "color": "#10152d",
      "command": "yarn dev --port {port} --strictPort"
    },
    {
      "role": "Working",
      "setup": [
        "git status --short --branch"
      ],
      "message": [
        "Forehead Frenzy — web app at http://localhost:{port:Frontend}/",
        "Tests:            yarn test          (one-shot)   /  yarn test:watch",
        "Build:            yarn build         -> dist/ (Capacitor webDir)",
        "Preview a build:  yarn preview --port {port:Frontend} --strictPort",
        "Deck generation:  GEMINI_API_KEY=... yarn generate:decks   (writes src/decks/*.toml; needs an interactive TTY if the key is unset)",
        "Native shells:    yarn build && npx cap sync ios   (then open ios/App in Xcode; same for android)",
        "Phone on LAN:     yarn dev --host --port {port:Frontend} --strictPort",
        "Store screenshots: yarn preview --port {port:Frontend} --strictPort, then yarn store:screenshots http://127.0.0.1:{port:Frontend}/"
      ],
